---
import Layout from '../../layouts/Layout.astro'
import { supabaseAdmin } from '../../lib/supabase'

const idParam = Astro.params.id
const id = Number(idParam)

const { data: pesanan } = supabaseAdmin
  ? await supabaseAdmin
      .from('pesanan')
      .select('id, customer_name, total, status')
      .eq('id', id)
      .maybeSingle()
  : { data: null }

const statusMap = {
  menunggu_pembayaran: 'Menunggu Pembayaran',
  diproses: 'Pesanan Sedang Diproses',
  siap_diambil: 'Siap Diambil',
  selesai: 'Selesai',
  dibatalkan: 'Dibatalkan',
}

const statusKey = pesanan?.status || 'menunggu_pembayaran'
const statusLabel = statusMap[statusKey] || 'Menunggu Pembayaran'
const totalRupiah = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
}).format(Number(pesanan?.total || 0))
---

<Layout title={`Tracking Pesanan #${idParam}`} showToast={false}>
  <main class="min-h-screen bg-[#FDF8F5] px-4 py-8 text-slate-900 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-3xl">
      <header class="mb-6 rounded-[1.75rem] bg-white p-6 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200">
        <p class="text-xs font-black uppercase tracking-[0.28em] text-[#e76f51]">Tracking Pesanan</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">Lihat Status Pesanan</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Halaman ini menampilkan status pesanan tanpa login, langsung dari tabel <code>pesanan</code>.
        </p>
      </header>

      <div class="grid gap-4 rounded-[1.75rem] bg-white p-6 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200">
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-4">
          <span class="text-sm font-bold text-slate-500">Nomor pesanan</span>
          <strong class="text-lg font-black text-slate-900">#{idParam}</strong>
        </div>

        <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-4">
          <span class="text-sm font-bold text-slate-500">Nama customer</span>
          <strong class="text-lg font-black text-slate-900">{pesanan?.customer_name || '-'}</strong>
        </div>

        <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-4">
          <span class="text-sm font-bold text-slate-500">Total pesanan</span>
          <strong class="text-lg font-black text-slate-900">{totalRupiah}</strong>
        </div>

        <div class="flex items-center justify-between gap-3">
          <span class="text-sm font-bold text-slate-500">Status pesanan</span>
          <span class="rounded-full bg-[#fff7f2] px-4 py-2 text-sm font-black text-slate-900 ring-1 ring-[#e76f51]/15">
            {statusLabel}
          </span>
        </div>
      </div>

      {!pesanan && (
        <p class="mt-4 text-sm text-slate-500">
          Pesanan tidak ditemukan.
        </p>
      )}
    </section>
  </main>
</Layout>
