---
import Layout from '../../layouts/Layout.astro'
import ConfettiEffect from '../../components/ConfettiEffect.jsx'
import { supabaseAdmin } from '../../lib/supabase'

const id = Astro.params.id
const isDev = import.meta.env.DEV === true
const whatsappCs = import.meta.env.PUBLIC_WHATSAPP_CS || ''
const testing = Astro.url.searchParams.get('testing') === '1'
const orderLabel = String(id).startsWith('ORD-') ? `#${id}` : `#ORD-${id}`

if (Astro.url.searchParams.has('snapToken') || Astro.url.searchParams.has('redirectUrl')) {
  const canonicalPath = `/pembayaran/${id}${testing ? '?testing=1' : ''}`
  return Astro.redirect(canonicalPath)
}

let pesanan = null
let pembayaran = null

if (supabaseAdmin) {
  const [{ data: orderData }, { data: paymentData }] = await Promise.all([
    supabaseAdmin
      .from('pesanan')
      .select('id, total, status, created_at, customer_name, tipe_pesanan, detail_pesanan(id, jumlah, harga_saat_pesan, menu(id, nama, gambar_url))')
      .eq('id', Number(id))
      .maybeSingle(),
    supabaseAdmin
      .from('pembayaran')
      .select('*')
      .eq('id_pesanan', Number(id))
      .maybeSingle(),
  ])

  pesanan = orderData
  pembayaran = paymentData
}

const menuItems = pesanan?.detail_pesanan || []
// Prefer server-provided order timestamp; avoid calling Date.now() on the server
const createdAt = pesanan?.created_at || null
const createdAtTimestamp = createdAt ? Date.parse(createdAt) : null
const deadlineTimestamp = createdAtTimestamp ? createdAtTimestamp + 15 * 60 * 1000 : null
const totalRupiah = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
}).format(Number(pesanan?.total || 0))
const snapToken = pembayaran?.snap_token || ''
const redirectUrl = pembayaran?.redirect_url || pembayaran?.payment_link || ''
---

<Layout title={`Pembayaran ${orderLabel}`}>
  <main class="min-h-screen bg-[#FDF8F5] px-4 py-6 text-slate-900 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-6xl">
      <header class="mb-6 rounded-[1.5rem] bg-white p-5 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.28em] text-[#e76f51]">Pembayaran</p>
            <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">🍜 Selesaikan Pembayaran</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
              Lanjutkan pembayaran melalui transfer bank sementara, lalu status akan diperbarui otomatis.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-[#FDF8F5] px-4 py-2 text-sm font-bold text-slate-700 ring-1 ring-slate-200">Order ID: <strong class="text-slate-900">{orderLabel}</strong></span>
            <span id="statusBadge" class="animate-pulse rounded-full bg-[#FEF3C7] px-4 py-2 text-sm font-bold text-[#92400e] ring-1 ring-[#f59e0b]/20">Menunggu Pembayaran</span>
          </div>
        </div>
      </header>

      <div class="mb-6 flex items-start gap-3 rounded-2xl border-l-4 border-[#F59E0B] bg-[#FEF3C7] px-4 py-3 text-sm leading-6 text-[#7c5a12] shadow-sm">
        <span>ℹ️</span>
        <p class="m-0">Saat ini pembayaran hanya transfer bank. QRIS/GoPay sedang maintenance.</p>
      </div>

      {(isDev || testing) && (
        <div class="mb-6 rounded-2xl border border-dashed border-[#2A9D8F]/30 bg-[#2A9D8F]/8 p-4 text-sm text-slate-700">
          <strong class="block text-[#2A9D8F]">Debug Pembayaran</strong>
          <p class="mt-1 mb-0">
            snapToken: <code>{snapToken ? 'tersedia' : 'kosong'}</code> | redirectUrl: <code>{redirectUrl ? 'tersedia' : 'kosong'}</code> | created_at: <code>{createdAt || 'unknown'}</code>
          </p>
        </div>
      )}

      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <section class="grid gap-6">
          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Timer</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">Waktu Pembayaran</h2>
              </div>
              <span class="rounded-full bg-[#2A9D8F]/10 px-3 py-1 text-xs font-bold text-[#2A9D8F]">15 menit</span>
            </div>
            <div class="mt-5 flex flex-col items-center gap-3">
              <div class="flex h-40 w-40 items-center justify-center rounded-full border-8 border-[#2A9D8F]/15 bg-[#FDF8F5] text-center">
                <div>
                  <div id="countdownDisplay" class="text-4xl font-black tracking-tight text-[#2A9D8F]">--:--</div>
                  <div class="mt-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Sisa waktu</div>
                </div>
              </div>
              <p class="text-sm text-slate-600">Timer dihitung dari waktu pesanan dibuat dan akan berubah warna saat mendekati batas.</p>
            </div>
          </article>

          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200 sm:p-6">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Detail Pesanan</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">Menu yang Dipesan</h2>
              </div>
              <span class="rounded-full bg-[#2A9D8F]/10 px-3 py-1 text-xs font-bold text-[#2A9D8F]">Dari Supabase</span>
            </div>

            <div class="overflow-hidden rounded-2xl border border-slate-200">
              <div class="grid grid-cols-[72px_1fr_auto] gap-4 bg-[#fff7f2] px-4 py-3 text-xs font-black uppercase tracking-[0.2em] text-slate-600">
                <span>Foto</span>
                <span>Menu</span>
                <span class="text-right">Harga</span>
              </div>
              <div class="divide-y divide-slate-200">
                {menuItems.length ? menuItems.map((item) => (
                  <div class="grid grid-cols-[72px_1fr_auto] items-center gap-4 px-4 py-4">
                    <div class="overflow-hidden rounded-2xl bg-[#FDF8F5] ring-1 ring-slate-200">
                      {item.menu?.gambar_url ? (
                        <img src={item.menu.gambar_url} alt={item.menu?.nama || 'Menu'} class="h-[72px] w-[72px] object-cover" />
                      ) : (
                        <div class="flex h-[72px] w-[72px] items-center justify-center text-xs font-bold text-slate-500">Menu</div>
                      )}
                    </div>
                    <div>
                      <strong class="block text-sm font-black text-slate-900">{item.menu?.nama || `Menu #${item.id_menu}`}</strong>
                      <span class="mt-1 inline-flex rounded-full bg-[#2A9D8F]/10 px-2 py-1 text-xs font-semibold text-[#2A9D8F]">Qty {item.jumlah}</span>
                    </div>
                    <div class="text-right text-sm font-black text-slate-900">
                      {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(item.harga_saat_pesan || 0) * Number(item.jumlah || 0))}
                    </div>
                  </div>
                )) : (
                  <div class="px-4 py-6 text-center text-sm text-slate-500">Detail pesanan belum tersedia.</div>
                )}
              </div>
            </div>

            <div class="mt-4 rounded-2xl bg-[#fff7f2] p-4 ring-1 ring-[#e76f51]/10">
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-bold text-slate-600">Total Harga</span>
                <strong class="text-2xl font-black tracking-tight text-slate-900">{totalRupiah}</strong>
              </div>
            </div>
          </article>
        </section>

        <aside class="grid gap-6">
          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200 sm:p-6">
            <div class="mb-4">
              <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Metode Pembayaran</p>
              <h2 class="mt-1 text-xl font-black text-slate-900">Transfer Bank</h2>
            </div>

            <div class="rounded-2xl border border-[#e76f51]/15 bg-[#fff7f2] p-4">
              <p class="m-0 text-sm leading-6 text-slate-700">
                BCA, BNI, BRI, dan Mandiri tersedia melalui Midtrans.
              </p>
            </div>
          </article>

          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200 sm:p-6">
            <div class="mb-4">
              <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Instruksi</p>
              <h2 class="mt-1 text-xl font-black text-slate-900">Buka Instruksi Transfer Bank</h2>
            </div>

            <div id="snapBox" class="rounded-2xl border-2 border-dashed border-[#e76f51] bg-[#FDF8F5] p-4 text-sm text-slate-600">
              Klik tombol di bawah untuk menampilkan instruksi transfer bank.
            </div>

            <div class="mt-4 grid gap-3">
              <button id="openPaymentButton" type="button" class="inline-flex items-center justify-center rounded-2xl bg-[#e76f51] px-4 py-3 text-sm font-black text-white shadow-[0_14px_28px_rgba(231,111,81,0.22)] transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50">
                💳 Buka Instruksi Transfer Bank
              </button>
              <button id="refreshButton" type="button" class="inline-flex items-center justify-center rounded-2xl border border-[#e76f51] px-4 py-3 text-sm font-black text-[#e76f51] transition hover:bg-[#e76f51] hover:text-white">
                🔄 Cek Status Pembayaran
              </button>
              <a id="whatsappButton" href="#" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-2xl bg-[#25D366] px-4 py-3 text-sm font-black text-white shadow-[0_14px_28px_rgba(37,211,102,0.22)] transition hover:-translate-y-0.5">
                💬 Hubungi Kasir
              </a>
            </div>

            {isDev && (
              <div class="mt-4 rounded-2xl border border-[#2A9D8F]/20 bg-[#2A9D8F]/10 p-4">
                <p class="m-0 text-sm font-semibold text-slate-700">Mode development aktif. Simulasi pembayaran tersedia.</p>
                <button id="simulateButton" type="button" class="mt-3 inline-flex w-full items-center justify-center rounded-2xl bg-[#2A9D8F] px-4 py-3 text-sm font-black text-white">
                  Simulasi Bayar (Testing)
                </button>
              </div>
            )}
          </article>
        </aside>
      </div>

      <div class="mt-6">
        <p id="noteText" class="m-0 text-sm text-slate-600">
          {snapToken ? 'Pesanan Anda sedang menunggu pembayaran.' : 'Metode pembayaran sedang maintenance, silakan coba lagi nanti.'}
        </p>
        <div id="timeoutArea" class="mt-4"></div>
      </div>
    </section>

    <ConfettiEffect client:load />
  </main>

  <script is:inline type="module">
  const ORDER_ID = ${JSON.stringify(id)}
  const SNAP_TOKEN = ${JSON.stringify(snapToken)}
  const REDIRECT_URL = ${JSON.stringify(redirectUrl)}
  const WHATSAPP_CS = ${JSON.stringify(whatsappCs)}
  // deadlineTimestamp may be null when order timestamp is unavailable; compute on client if needed
  const DEADLINE = ${JSON.stringify(deadlineTimestamp)}
  // If server did not provide a deadline, compute a safe client-side default
  const DEADLINE_TIMESTAMP = DEADLINE || (Date.now() + 15 * 60 * 1000)
  const IS_DEV = ${JSON.stringify(isDev)}
  const MIDTRANS_CLIENT_KEY = ${JSON.stringify(import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || '')}
  const MIDTRANS_IS_PRODUCTION = ${JSON.stringify(String(import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION || 'false') === 'true')}

  window.DEADLINE_TIMESTAMP = DEADLINE_TIMESTAMP
  // expose snap token to window for debugging/compatibility but keep local const as source of truth
  window.snapToken = SNAP_TOKEN
  console.log('Token:', SNAP_TOKEN)

    const money = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    })

    const countdownEl = document.getElementById('countdownDisplay')
    const noteTextEl = document.getElementById('noteText')
    const timeoutAreaEl = document.getElementById('timeoutArea')
    const statusBadgeEl = document.getElementById('statusBadge')
    const openPaymentButton = document.getElementById('openPaymentButton')
    const refreshButton = document.getElementById('refreshButton')
    const whatsappButton = document.getElementById('whatsappButton')
    const simulateButton = document.getElementById('simulateButton')
    const snapBox = document.getElementById('snapBox')

    function normalizePhone(value) {
      return String(value || '').replace(/[^\d]/g, '')
    }

    function waLink(message) {
      const phone = normalizePhone(WHATSAPP_CS)
      if (!phone) return '#'
      return `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
    }

    if (WHATSAPP_CS && whatsappButton) {
      whatsappButton.href = waLink(`Halo Kasir, saya ingin konfirmasi pembayaran untuk pesanan #${ORDER_ID}.`)
    }

    function formatCountdown(ms) {
      const total = Math.max(0, Math.floor(ms / 1000))
      const minutes = String(Math.floor(total / 60)).padStart(2, '0')
      const seconds = String(total % 60).padStart(2, '0')
      return `${minutes}:${seconds}`
    }

    function tickCountdown() {
      const remaining = DEADLINE - Date.now()
      if (countdownEl) {
        countdownEl.textContent = formatCountdown(remaining)
        countdownEl.style.color = remaining < 2 * 60 * 1000 ? '#ef4444' : remaining < 5 * 60 * 1000 ? '#f59e0b' : '#2A9D8F'
      }

      if (remaining <= 0) {
        noteTextEl.textContent = 'Waktu habis, silakan hubungi kasir.'
        timeoutAreaEl.innerHTML = `
          <a class="inline-flex items-center justify-center rounded-2xl bg-[#ef4444] px-4 py-3 text-sm font-black text-white shadow-[0_14px_28px_rgba(239,68,68,0.18)]" href="${waLink(`Halo Kasir, waktu pembayaran pesanan #${ORDER_ID} sudah habis. Mohon bantu batalkan pesanan.`)}" target="_blank" rel="noreferrer">
            Batalkan Pesanan
          </a>
        `
      }
    }

    function loadSnapScript() {
      if (window.snap) return Promise.resolve()
      return new Promise((resolve, reject) => {
        const script = document.createElement('script')
        script.async = true
        script.src = MIDTRANS_IS_PRODUCTION ? 'https://app.midtrans.com/snap/snap.js' : 'https://app.sandbox.midtrans.com/snap/snap.js'
        script.setAttribute('data-client-key', MIDTRANS_CLIENT_KEY)
        script.onload = resolve
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    function openPayment() {
      if (!SNAP_TOKEN) {
        snapBox.textContent = 'Metode pembayaran sedang maintenance, silakan coba lagi nanti'
        return
      }

      loadSnapScript()
        .then(() => {
          if (!window.snap?.pay) throw new Error('Snap Midtrans belum siap')
          window.snap.pay(SNAP_TOKEN, {
            onSuccess: () => {
              window.location.href = `/pembayaran/sukses/${ORDER_ID}`
            },
            onPending: () => {
              noteTextEl.textContent = 'Menunggu konfirmasi transfer bank.'
            },
            onError: () => {
              noteTextEl.textContent = 'Gagal membuka instruksi transfer bank.'
            },
            onClose: () => {
              noteTextEl.textContent = 'Instruksi pembayaran ditutup.'
            },
          })
        })
        .catch(() => {
          if (REDIRECT_URL) {
            window.open(REDIRECT_URL, '_blank', 'noopener,noreferrer')
            return
          }
          snapBox.textContent = 'Metode pembayaran sedang maintenance, silakan coba lagi nanti'
        })
    }

    function simulatePay() {
      if (!IS_DEV) return
      window.location.href = `/pembayaran/sukses/${ORDER_ID}?testing=1`
    }

    async function refreshStatus() {
      try {
        const url = new URL('/api/cek-status', window.location.origin)
        url.searchParams.set('id', ORDER_ID)
        const response = await fetch(url, { cache: 'no-store' })
        const data = await response.json()

        if (response.ok && data?.pembayaran?.status) {
          const value = String(data.pembayaran.status).toLowerCase()
          const label = value === 'paid' || value === 'settlement' || value === 'capture'
            ? 'Pembayaran Diterima'
            : value === 'failed'
              ? 'Pembayaran Gagal'
              : 'Menunggu Pembayaran'
          statusBadgeEl.textContent = label
        }

        if (data?.pembayaran?.status && ['paid', 'settlement', 'capture'].includes(String(data.pembayaran.status).toLowerCase())) {
          window.location.href = `/pembayaran/sukses/${ORDER_ID}`
        }
      } catch (error) {
        console.error(error)
      }
    }

    openPaymentButton?.addEventListener('click', openPayment)
    refreshButton?.addEventListener('click', refreshStatus)
    simulateButton?.addEventListener('click', simulatePay)

    tickCountdown()
    window.setInterval(tickCountdown, 1000)
    window.setInterval(refreshStatus, 5000)
  </script>
</Layout>
