---
import Layout from '../../layouts/Layout.astro'
import ConfettiEffect from '../../components/ConfettiEffect.jsx'

const id = Astro.params.id
const whatsappCs = import.meta.env.PUBLIC_WHATSAPP_CS || ''
const testing = Astro.url.searchParams.get('testing') === '1'
const midtransClientKey = import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || ''
const midtransProduction = String(import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION || 'false') === 'true'
const orderBadge = String(id).startsWith('ORD-') ? `#${id}` : `#ORD-${id}`
---

<Layout title={`Pembayaran Pesanan ${orderBadge}`}>
  <main class="payment-page-shell">
    <section class="payment-page" data-order-id={id} data-testing={testing ? 'true' : 'false'} data-whatsapp-cs={whatsappCs}>
      <header class="payment-hero">
        <div>
          <p class="payment-eyebrow">Pembayaran</p>
          <h1>🍜 Selesaikan Pembayaran</h1>
          <p class="payment-subtitle">Selesaikan pembayaran sebelum timer habis agar pesanan langsung diproses.</p>
        </div>
        <div class="payment-badges">
          <span class="payment-badge payment-badge-muted">Order ID: <strong id="orderNumber">{orderBadge}</strong></span>
          <span class="payment-badge payment-badge-warning" id="statusBadge">Menunggu pembayaran</span>
        </div>
      </header>

      <div class="payment-announcement" role="note" aria-label="Informasi pembayaran">
        <span class="payment-announcement-icon">ℹ️</span>
        <p>Saat ini pembayaran hanya QRIS. Metode lain sedang maintenance.</p>
      </div>

      <section class="payment-grid">
        <div class="payment-column">
          <article class="payment-card payment-card-timer">
            <p class="payment-card-label">Batas Waktu Pembayaran</p>
            <div class="payment-countdown" id="countdown">15:00</div>
            <p class="payment-helper" id="timerHelper">Waktu tersisa untuk menyelesaikan pembayaran.</p>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Informasi Pesanan</h2>
              <span class="payment-mini-badge" id="paymentMethodTag">QRIS</span>
            </div>
            <div class="payment-info-grid">
              <div class="payment-info-item">
                <span>Nomor Pesanan</span>
                <strong id="infoOrderNumber">-</strong>
              </div>
              <div class="payment-info-item">
                <span>Total Bayar</span>
                <strong id="infoTotal">-</strong>
              </div>
              <div class="payment-info-item">
                <span>Status</span>
                <strong id="infoStatus">Menunggu pembayaran</strong>
              </div>
              <div class="payment-info-item">
                <span>Waktu Pesanan</span>
                <strong id="infoTime">-</strong>
              </div>
            </div>
            <div class="payment-order-meta">
              <p><strong>Tipe Pesanan:</strong> <span id="infoType">-</span></p>
              <p><strong>Nama Customer:</strong> <span id="infoCustomer">-</span></p>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Detail Pesanan</h2>
              <span class="payment-mini-note">Nama, jumlah, harga</span>
            </div>
            <div class="payment-table-wrap">
              <table class="payment-table">
                <thead>
                  <tr>
                    <th>Menu</th>
                    <th>Jumlah</th>
                    <th>Harga</th>
                  </tr>
                </thead>
                <tbody id="menuTable">
                  <tr>
                    <td colspan="3" class="payment-empty-cell">Memuat detail pesanan...</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="payment-totals">
              <div>
                <span>Subtotal</span>
                <strong id="subtotalValue">-</strong>
              </div>
              <div>
                <span>Total</span>
                <strong id="totalValue">-</strong>
              </div>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Metode Pembayaran</h2>
              <span class="payment-mini-note">QRIS aktif</span>
            </div>
            <div class="payment-method-grid" id="methodGrid"></div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Instruksi Pembayaran</h2>
              <span class="payment-mini-note">Langkah mudah</span>
            </div>
            <ol class="payment-steps">
              <li>Scan QR code di samping menggunakan GoPay, OVO, Dana, atau aplikasi QRIS lainnya.</li>
              <li>Pastikan nominal yang tampil sesuai total pesanan.</li>
              <li>Setelah berhasil, status akan otomatis berubah dan Anda akan diarahkan ke halaman sukses.</li>
            </ol>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Tombol Aksi</h2>
              <span class="payment-mini-note">Cepat dan praktis</span>
            </div>
            <div class="payment-actions">
              <button class="payment-button payment-button-secondary" id="refreshButton" type="button">🔄 Cek Status Pembayaran</button>
              <a class="payment-button payment-button-primary" id="whatsappButton" href="#" target="_blank" rel="noreferrer">💬 Hubungi Kasir</a>
            </div>
          </article>
        </div>

        <aside class="payment-column payment-side">
          <article class="payment-card payment-qr-card">
            <div class="payment-card-header payment-card-header-center">
              <h2>QR Code Pembayaran</h2>
            </div>
            <div class="payment-qr-timer" id="sideTimer">15:00</div>
            <div class="payment-qr-shell">
              <div class="payment-qr-stage" id="qrStage">
                <p class="payment-empty-state">Memuat QR code...</p>
              </div>
            </div>
            <p class="payment-qr-caption">Scan QR code di atas menggunakan GoPay, OVO, Dana, atau aplikasi QRIS lainnya.</p>
            <div class="payment-qr-actions" id="timeoutArea"></div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Announcement</h2>
            </div>
            <div class="payment-announcement payment-announcement-block">
              <span class="payment-announcement-icon">ℹ️</span>
              <p>Saat ini pembayaran hanya QRIS. Metode lain sedang maintenance.</p>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Catatan</h2>
            </div>
            <p class="payment-helper" id="noteText">Pesanan Anda sedang menunggu pembayaran.</p>
          </article>
        </aside>
      </section>
    </section>

    <ConfettiEffect client:load />
  </main>

  <script is:inline type="module">
    const ORDER_ID = ${JSON.stringify(id)}
    const ORDER_BADGE = ${JSON.stringify(orderBadge)}
    const TESTING = ${JSON.stringify(testing)}
    const WHATSAPP_CS = ${JSON.stringify(whatsappCs)}
    const MIDTRANS_CLIENT_KEY = ${JSON.stringify(midtransClientKey)}
    const MIDTRANS_IS_PRODUCTION = ${JSON.stringify(midtransProduction)}

    const money = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    })

    const state = {
      deadline: Date.now() + 15 * 60 * 1000,
      timerId: null,
      pollId: null,
      timedOut: false,
      redirecting: false,
      retries404: 0,
    }

    const els = {
      countdown: document.getElementById('countdown'),
      sideTimer: document.getElementById('sideTimer'),
      timerHelper: document.getElementById('timerHelper'),
      statusBadge: document.getElementById('statusBadge'),
      paymentMethodTag: document.getElementById('paymentMethodTag'),
      infoOrderNumber: document.getElementById('infoOrderNumber'),
      infoTotal: document.getElementById('infoTotal'),
      infoStatus: document.getElementById('infoStatus'),
      infoTime: document.getElementById('infoTime'),
      infoType: document.getElementById('infoType'),
      infoCustomer: document.getElementById('infoCustomer'),
      menuTable: document.getElementById('menuTable'),
      subtotalValue: document.getElementById('subtotalValue'),
      totalValue: document.getElementById('totalValue'),
      methodGrid: document.getElementById('methodGrid'),
      qrStage: document.getElementById('qrStage'),
      timeoutArea: document.getElementById('timeoutArea'),
      noteText: document.getElementById('noteText'),
      whatsappButton: document.getElementById('whatsappButton'),
      refreshButton: document.getElementById('refreshButton'),
    }

    const methods = [
      {
        key: 'qris',
        icon: '📱',
        title: 'QRIS',
        desc: 'Scan QR Code dengan GoPay, OVO, Dana, dll',
        steps: [
          'Scan QR code di atas menggunakan GoPay, OVO, Dana, atau aplikasi QRIS lainnya.',
          'Pastikan nominal sesuai total pesanan.',
          'Tunggu status berubah otomatis setelah pembayaran berhasil.',
        ],
      },
      {
        key: 'gopay',
        icon: '💳',
        title: 'GoPay',
        desc: 'Bayar dengan GoPay',
        steps: ['Buka aplikasi GoPay.', 'Konfirmasi transaksi yang muncul.', 'Tunggu status pembelian selesai.'],
      },
      {
        key: 'shopeepay',
        icon: '🛍️',
        title: 'ShopeePay',
        desc: 'Bayar dengan ShopeePay',
        steps: ['Buka ShopeePay.', 'Lakukan konfirmasi pembayaran.', 'Selesaikan transaksi sebelum waktu habis.'],
      },
      {
        key: 'bank_transfer',
        icon: '🏦',
        title: 'Bank Transfer',
        desc: 'Transfer Bank BCA / BNI / BRI / Mandiri',
        steps: ['Gunakan virtual account atau instruksi transfer.', 'Transfer sesuai nominal.', 'Simpan bukti transfer jika dibutuhkan.'],
      },
    ]

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;')
    }

    function formatDateTime(value) {
      if (!value) return '-'
      return new Intl.DateTimeFormat('id-ID', {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }).format(new Date(value))
    }

    function formatCountdown(ms) {
      const total = Math.max(0, Math.floor(ms / 1000))
      const minutes = String(Math.floor(total / 60)).padStart(2, '0')
      const seconds = String(total % 60).padStart(2, '0')
      return `${minutes}:${seconds}`
    }

    function normalizePhone(value) {
      return String(value || '').replace(/[^\d]/g, '')
    }

    function waLink(message) {
      const phone = normalizePhone(WHATSAPP_CS)
      if (!phone) return '#'
      return `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
    }

    function setWhatsappButton(orderId) {
      els.whatsappButton.href = waLink(`Halo Kasir, saya ingin konfirmasi pembayaran untuk pesanan ${ORDER_BADGE || `#${orderId}`}.`)
    }

    function setStatusBadge(status) {
      const normalized = String(status || 'pending').toLowerCase()
      const map = {
        pending: { label: 'Menunggu pembayaran', className: 'status-pending' },
        paid: { label: 'Pembayaran diterima', className: 'status-success' },
        settlement: { label: 'Pembayaran diterima', className: 'status-success' },
        capture: { label: 'Pembayaran diterima', className: 'status-success' },
        failed: { label: 'Pembayaran gagal', className: 'status-danger' },
        cancel: { label: 'Pesanan dibatalkan', className: 'status-danger' },
        expired: { label: 'Waktu pembayaran habis', className: 'status-danger' },
      }
      const selected = map[normalized] || map.pending
      els.statusBadge.className = `payment-badge ${selected.className}`
      els.statusBadge.innerText = selected.label
      els.infoStatus.innerText = selected.label
    }

    function renderMethods(activeKey = 'qris') {
      els.methodGrid.innerHTML = methods.map((item) => `
        <article class="method-card ${item.key === activeKey ? 'is-active' : ''}">
          <div class="method-icon">${item.icon}</div>
          <div>
            <strong>${escapeHtml(item.title)}</strong>
            <p>${escapeHtml(item.desc)}</p>
          </div>
        </article>
      `).join('')
      els.paymentMethodTag.innerText = methods.find((item) => item.key === activeKey)?.title || 'QRIS'
    }

    function renderMenuRows(items = []) {
      if (!items.length) {
        els.menuTable.innerHTML = '<tr><td colspan="3" class="payment-empty-cell">Detail menu belum tersedia.</td></tr>'
        return
      }

      els.menuTable.innerHTML = items.map((item) => {
        const nama = item.menu?.nama || item.nama_menu || `Menu #${item.id_menu}`
        const qty = Number(item.jumlah || 0)
        const hargaSatuan = Number(item.harga_saat_pesan ?? item.harga ?? 0)
        return `
          <tr>
            <td>${escapeHtml(nama)}</td>
            <td>${qty}</td>
            <td>${money.format(hargaSatuan * qty)}</td>
          </tr>
        `
      }).join('')
    }

    function buildQrSource(data) {
      const payment = data?.pembayaran || {}
      const candidates = [
        payment.qr_code,
        payment.qr_url,
        payment.redirect_url,
        data?.midtrans?.qr_url,
        data?.midtrans?.redirect_url,
      ].filter(Boolean)
      return candidates[0] || null
    }

    function renderQr(source, snapToken) {
      if (source) {
        els.qrStage.innerHTML = `
          <img class="payment-qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(source)}" alt="QR code pembayaran" width="300" height="300" />
        `
        return
      }

      if (snapToken && window.snap?.embed) {
        els.qrStage.innerHTML = '<div id="snap-embed"></div>'
        window.snap.embed(snapToken, {
          embedId: 'snap-embed',
          onPending: () => { els.noteText.innerText = 'Menunggu konfirmasi pembayaran.' },
          onSuccess: () => { els.noteText.innerText = 'Pembayaran berhasil diproses.' },
          onError: () => { els.noteText.innerText = 'Midtrans sedang memuat tampilan pembayaran.' },
        })
        return
      }

      els.qrStage.innerHTML = '<p class="payment-empty-state">Menunggu QR code dari Midtrans...</p>'
    }

    function renderTimeoutAction(orderId) {
      els.timeoutArea.innerHTML = `
        <a class="payment-button payment-button-danger" href="${waLink(`Halo Kasir, waktu pembayaran pesanan ${ORDER_BADGE || `#${orderId}`} sudah habis. Mohon bantu batalkan pesanan.`)}" target="_blank" rel="noreferrer">
          Batalkan Pesanan
        </a>
      `
    }

    function clearTimeoutAction() {
      els.timeoutArea.innerHTML = ''
    }

    function stopTimers() {
      if (state.timerId) window.clearInterval(state.timerId)
      if (state.pollId) window.clearInterval(state.pollId)
    }

    function setDeadline(createdAt) {
      state.deadline = (createdAt ? new Date(createdAt).getTime() : Date.now()) + 15 * 60 * 1000
    }

    function tickCountdown() {
      const remaining = state.deadline - Date.now()
      const formatted = formatCountdown(remaining)
      els.countdown.innerText = formatted
      els.sideTimer.innerText = formatted

      const urgent = remaining > 0 && remaining < 3 * 60 * 1000
      els.countdown.classList.toggle('is-urgent', urgent)
      els.sideTimer.classList.toggle('is-urgent', urgent)

      if (remaining <= 0 && !state.timedOut) {
        state.timedOut = true
        els.timerHelper.innerText = 'Waktu pembayaran habis.'
        els.noteText.innerText = 'Waktu habis, silakan hubungi kasir.'
        renderTimeoutAction(ORDER_ID)
        stopTimers()
      }
    }

    function renderOrder(data) {
      const pesanan = data?.pesanan
      const pembayaran = data?.pembayaran || {}
      if (!pesanan) {
        els.qrStage.innerHTML = '<p class="payment-empty-state">Pesanan tidak ditemukan.</p>'
        els.noteText.innerText = 'Data pesanan belum tersedia.'
        return
      }

      setDeadline(pesanan.created_at)
      els.infoOrderNumber.innerText = `#${pesanan.id}`
      els.infoTotal.innerText = money.format(Number(pesanan.total || 0))
      els.infoTime.innerText = formatDateTime(pesanan.created_at)
      els.infoCustomer.innerText = pesanan.customer_name || '-'
      els.infoType.innerText = pesanan.tipe_pesanan === 'dine_in'
        ? `Dine-in${pesanan.meja?.nomor_meja ? ` (Meja ${pesanan.meja.nomor_meja})` : ''}`
        : pesanan.tipe_pesanan === 'delivery'
          ? 'Delivery'
          : 'Takeaway'

      setStatusBadge(pembayaran.status || pesanan.status || 'pending')
      renderMethods(pembayaran.metode === 'midtrans' ? 'qris' : (pembayaran.metode || 'qris'))
      renderMenuRows(pesanan.detail_pesanan || [])
      setWhatsappButton(pesanan.id)

      const qrSource = buildQrSource(data)
      renderQr(qrSource, pembayaran.snap_token)

      if (['paid', 'settlement', 'capture'].includes(String(pembayaran.status || '').toLowerCase())) {
        stopTimers()
        clearTimeoutAction()
        els.timerHelper.innerText = 'Pembayaran sudah berhasil diterima.'
        els.noteText.innerText = 'Terima kasih, pesanan Anda sedang kami proses.'
        window.setTimeout(() => {
          window.location.href = `/pembayaran/sukses/${pesanan.id}`
        }, 1200)
        return
      }

      if (state.timedOut) {
        renderTimeoutAction(pesanan.id)
      } else {
        clearTimeoutAction()
      }
    }

    function loadSnapScript() {
      if (window.snap) return Promise.resolve()
      return new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-midtrans-snap="true"]')
        if (existing) {
          existing.addEventListener('load', resolve, { once: true })
          existing.addEventListener('error', reject, { once: true })
          return
        }

        const script = document.createElement('script')
        script.dataset.midtransSnap = 'true'
        script.async = true
        script.src = MIDTRANS_IS_PRODUCTION ? 'https://app.midtrans.com/snap/snap.js' : 'https://app.sandbox.midtrans.com/snap/snap.js'
        script.setAttribute('data-client-key', MIDTRANS_CLIENT_KEY)
        script.onload = resolve
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    async function refreshStatus(manual = false) {
      if (state.timedOut && !manual) return
      try {
        const url = new URL('/api/cek-status', window.location.origin)
        url.searchParams.set('id', ORDER_ID)
        if (TESTING) url.searchParams.set('testing', '1')

        const response = await fetch(url.toString(), { cache: 'no-store' })
        const data = await response.json()

        if (response.status === 404 || data?.not_found) {
          state.retries404 += 1
          if (data?.pesanan) {
            renderOrder({
              ...data,
              pembayaran: data.pembayaran || { status: 'pending', metode: 'midtrans' },
            })
          }
          if (state.retries404 >= 10) {
            els.noteText.innerText = 'Transaksi belum ditemukan di Midtrans. Status dianggap pending.'
          }
          return
        }

        renderOrder(data)
      } catch (error) {
        console.error(error)
        els.noteText.innerText = 'Gagal memuat status pembayaran. Silakan coba lagi.'
      }
    }

    els.refreshButton.addEventListener('click', () => refreshStatus(true))

    if (TESTING) {
      els.noteText.innerText = 'Mode testing aktif.'
    }

    state.timerId = window.setInterval(tickCountdown, 1000)
    state.pollId = window.setInterval(() => refreshStatus(false), 5000)
    tickCountdown()

    if (TESTING) {
      refreshStatus(true)
    } else {
      loadSnapScript().catch(() => {})
      refreshStatus(true)
    }
  </script>

  <style>
    :global(body) {
      background: #fdf8f5;
    }

    .payment-page-shell {
      min-height: 100vh;
      padding: 2rem 1rem 3rem;
      background:
        radial-gradient(circle at top left, rgba(231, 111, 81, .14), transparent 28%),
        radial-gradient(circle at top right, rgba(42, 157, 143, .12), transparent 24%),
        #fdf8f5;
    }

    .payment-page {
      max-width: 1180px;
      margin: 0 auto;
    }

    .payment-hero {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .payment-eyebrow {
      margin: 0 0 .35rem;
      color: #e76f51;
      font-size: .85rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .payment-hero h1 {
      margin: 0;
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1.05;
      color: #2b1f1a;
    }

    .payment-subtitle {
      margin: .6rem 0 0;
      color: rgba(43, 31, 26, .72);
      max-width: 58ch;
    }

    .payment-badges {
      display: flex;
      flex-wrap: wrap;
      gap: .7rem;
      align-items: center;
    }

    .payment-badge {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .75rem 1rem;
      border-radius: 999px;
      font-size: .92rem;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(43, 31, 26, .08);
    }

    .payment-badge strong {
      font-weight: 900;
    }

    .payment-badge-muted {
      color: #2b1f1a;
      background: rgba(255, 255, 255, .95);
    }

    .payment-badge-warning {
      background: #fef3c7;
      color: #92400e;
      animation: paymentPulse 1.8s ease-in-out infinite;
    }

    .status-pending {
      background: #fef3c7;
      color: #92400e;
      animation: paymentPulse 1.8s ease-in-out infinite;
    }

    .status-success {
      background: #dcfce7;
      color: #166534;
    }

    .status-danger {
      background: #fee2e2;
      color: #991b1b;
    }

    .payment-announcement {
      display: flex;
      align-items: flex-start;
      gap: .85rem;
      padding: .95rem 1rem;
      margin-bottom: 1rem;
      background: #fef3c7;
      border-left: 4px solid #f59e0b;
      border-radius: .95rem;
      color: #5c4211;
      box-shadow: 0 10px 24px rgba(43, 31, 26, .06);
    }

    .payment-announcement p {
      margin: 0;
      font-size: .94rem;
      line-height: 1.55;
    }

    .payment-announcement-icon {
      flex: none;
      width: 1.7rem;
      height: 1.7rem;
      display: grid;
      place-items: center;
      border-radius: 999px;
      background: rgba(255, 255, 255, .6);
    }

    .payment-announcement-block {
      margin-bottom: 0;
    }

    .payment-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 1rem;
      align-items: start;
    }

    .payment-column {
      display: grid;
      gap: 1rem;
    }

    .payment-side {
      position: sticky;
      top: 1rem;
    }

    .payment-card {
      background: rgba(255, 255, 255, .98);
      border: 1px solid rgba(43, 31, 26, .08);
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: 0 16px 36px rgba(43, 31, 26, .07);
    }

    .payment-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      margin-bottom: .9rem;
    }

    .payment-card-header-center {
      justify-content: center;
    }

    .payment-card h2 {
      margin: 0;
      font-size: 1.05rem;
      color: #2b1f1a;
    }

    .payment-mini-badge,
    .payment-mini-note {
      display: inline-flex;
