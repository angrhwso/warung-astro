---
import Layout from '../../layouts/Layout.astro'
import { supabaseAdmin } from '../../lib/supabase'

const idParam = Astro.params.id
const id = Number(idParam)

const { data: pesanan } = supabaseAdmin
  ? await supabaseAdmin
      .from('pesanan')
      .select('id, pembayaran(snap_token)')
      .eq('id', id)
      .maybeSingle()
  : { data: null }

const paymentRaw = pesanan?.pembayaran
const pembayaran = Array.isArray(paymentRaw) ? paymentRaw[0] : paymentRaw
const snapToken = pembayaran?.snap_token || ''
---

<Layout title={`Pembayaran #${idParam}`} showToast={false}>
  <main class="min-h-screen bg-[#FDF8F5] px-4 py-8 text-slate-900">
    <section class="mx-auto flex min-h-[60vh] max-w-xl items-center">
      <div class="w-full rounded-[1.5rem] bg-white p-6 shadow-[0_18px_50px_rgba(43,31,26,0.08)] ring-1 ring-slate-200">
        <p class="text-xs font-black uppercase tracking-[0.28em] text-[#e76f51]">Pembayaran</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">Midtrans Snap</h1>
        <p id="payment-status" class="mt-3 text-sm leading-6 text-slate-600">
          {snapToken ? 'Snap token ditemukan. Midtrans akan dibuka.' : 'Snap token belum tersedia.'}
        </p>
      </div>
    </section>
  </main>

  <div
    id="payment-config"
    hidden
    data-snap-token={snapToken}
    data-midtrans-client-key={import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || ''}
    data-midtrans-is-production={String(import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION || 'false')}
  />

  <script src="/payment-page.js" defer></script>
</Layout>
