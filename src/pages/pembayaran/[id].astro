---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const id = Astro.params.id;

// Ambil data pesanan + detail menu + snap_token
const { data: pesanan, error } = await supabase
  .from('pesanan')
  .select(`
    *,
    detail_pesanan (
      id, jumlah, harga_saat_pesan,
      menu (id, nama, harga)
    ),
    pembayaran (snap_token, status)
  `)
  .eq('id', id)
  .single();

if (error || !pesanan) {
  return Astro.redirect('/');
}

const items = pesanan.detail_pesanan || [];
const total = items.reduce((sum, item) => sum + (item.jumlah * item.harga_saat_pesan), 0);
const snapToken = pesanan.pembayaran?.[0]?.snap_token || null;
const createdAt = pesanan.created_at;

// Hitung sisa waktu di server (opsional)
const deadline = new Date(createdAt).getTime() + 15 * 60 * 1000;
const remaining = Math.max(0, Math.floor((deadline - Date.now()) / 1000));
const initialMinutes = Math.floor(remaining / 60);
const initialSeconds = remaining % 60;
---

<Layout title="Pembayaran">
  <div class="max-w-md mx-auto p-4">
    <div class="bg-white rounded-xl shadow-lg p-5">
      
      <h1 class="text-xl font-bold text-center">🍜 Selesaikan Pembayaran</h1>
      <p class="text-center text-gray-500 text-sm">Order #{pesanan.id}</p>
      
      {/* TIMER - Versi Manual dengan JavaScript */}
      <div class="bg-orange-50 p-3 rounded-lg text-center my-4">
        <p class="text-sm">Selesaikan dalam:</p>
        <div id="timerDisplay" class="text-3xl font-bold font-mono">
          {String(initialMinutes).padStart(2, '0')}:{String(initialSeconds).padStart(2, '0')}
        </div>
      </div>
      
      {/* DAFTAR MENU */}
      <div class="border rounded-lg p-3 my-4">
        <h3 class="font-bold mb-2">🍽️ Pesanan Anda:</h3>
        {items.length === 0 ? (
          <p class="text-gray-500 text-sm">Tidak ada item</p>
        ) : (
          items.map(item => (
            <div class="flex justify-between text-sm py-1 border-b last:border-0">
              <span>{item.menu?.nama} <span class="text-gray-500">x{item.jumlah}</span></span>
              <span>Rp {(item.jumlah * item.harga_saat_pesan).toLocaleString()}</span>
            </div>
          ))
        )}
        <div class="mt-2 pt-2 font-bold flex justify-between border-t">
          <span>Total</span>
          <span>Rp {total.toLocaleString()}</span>
        </div>
      </div>
      
      {/* METODE PEMBAYARAN */}
      <div class="bg-blue-50 p-3 rounded-lg text-center text-sm my-4">
        <p class="font-bold">🏦 Bank Transfer (BCA/BNI/BRI/Mandiri)</p>
        <p class="text-gray-600 mt-1">Klik tombol di bawah untuk melihat instruksi pembayaran.</p>
      </div>
      
      {/* TOMBOL BAYAR */}
      <button id="payButton" class="w-full bg-orange-500 text-white py-3 rounded-lg font-bold mt-2">
        💳 Buka Pembayaran
      </button>
      
      <a href="/" class="block text-center text-gray-500 text-sm mt-4">← Kembali</a>
      
    </div>
  </div>
  
  <script is:inline>
    // Data dari server
    const snapToken = { JSON.stringify(snapToken) };
    const clientKey = { JSON.stringify(import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || '') };
    const isProduction = { JSON.stringify(import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION || 'false') } === 'true';
    const deadlineServer = { deadline };
    
    // ========== TIMER ==========
    function updateTimer() {
      const now = Date.now();
      const remaining = Math.max(0, Math.floor((deadlineServer - now) / 1000));
      const minutes = Math.floor(remaining / 60);
      const seconds = remaining % 60;
      const timerDisplay = document.getElementById('timerDisplay');
      if (timerDisplay) {
        timerDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        if (remaining <= 0) {
          timerDisplay.style.color = 'red';
        } else if (remaining < 300) {
          timerDisplay.style.color = 'orange';
        } else {
          timerDisplay.style.color = 'green';
        }
      }
    }
    
    updateTimer();
    const timerInterval = setInterval(updateTimer, 1000);
    
    // ========== PAYMENT ==========
    function loadSnapAndPay() {
      if (!snapToken) {
        alert('Token pembayaran tidak ditemukan. Silakan hubungi kasir.');
        return;
      }
      
      // Load Snap.js jika belum ada
      if (window.snap) {
        window.snap.pay(snapToken, {
          onSuccess: () => { window.location.href = '/sukses'; },
          onError: (err) => { alert('Error: ' + JSON.stringify(err)); }
        });
        return;
      }
      
      // Load script Snap.js dulu
      const script = document.createElement('script');
      script.src = isProduction 
        ? 'https://app.midtrans.com/snap/snap.js' 
        : 'https://app.sandbox.midtrans.com/snap/snap.js';
      script.setAttribute('data-client-key', clientKey);
      script.onload = () => {
        window.snap.pay(snapToken, {
          onSuccess: () => { window.location.href = '/sukses'; },
          onError: (err) => { alert('Error: ' + JSON.stringify(err)); }
        });
      };
      script.onerror = () => { alert('Gagal memuat Midtrans Snap'); };
      document.head.appendChild(script);
    }
    
    // Pasang event listener ke tombol
    const btn = document.getElementById('payButton');
    if (btn) {
      btn.onclick = loadSnapAndPay;
    }
    
    // Cleanup timer saat halaman ditutup
    window.addEventListener('beforeunload', () => clearInterval(timerInterval));
  </script>
</Layout>