---
import Layout from '../../layouts/Layout.astro'
import ConfettiEffect from '../../components/ConfettiEffect.jsx'
import PaymentCountdown from '../../components/PaymentCountdown.jsx'

const id = Astro.params.id
const whatsappCs = import.meta.env.PUBLIC_WHATSAPP_CS || ''
const testing = Astro.url.searchParams.get('testing') === '1'
const midtransClientKey = import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || ''
const midtransProduction = String(import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION || 'false') === 'true'
const orderLabel = String(id).startsWith('ORD-') ? `#${id}` : `#ORD-${id}`
---

<Layout title={`Pembayaran ${orderLabel}`}>
  <main class="min-h-screen bg-[#FDF8F5] px-4 py-6 text-slate-900 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
      <header class="mb-6 flex flex-col gap-4 rounded-[1.75rem] border border-[#e76f51]/10 bg-white/80 p-5 shadow-[0_18px_60px_rgba(43,31,26,0.08)] backdrop-blur sm:p-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="mb-2 text-xs font-black uppercase tracking-[0.28em] text-[#e76f51]">Pembayaran</p>
          <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">🍜 Selesaikan Pembayaran</h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
            Bayar pesanan Anda dengan QRIS, lalu tunggu konfirmasi otomatis dari sistem.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center rounded-full bg-[#FDF8F5] px-4 py-2 text-sm font-bold text-slate-700 ring-1 ring-slate-200">
            Order ID: <strong class="ml-1 text-slate-900">{orderLabel}</strong>
          </span>
          <span id="statusBadge" class="inline-flex animate-pulse items-center rounded-full bg-[#FEF3C7] px-4 py-2 text-sm font-bold text-[#92400e] ring-1 ring-[#f59e0b]/20">
            Menunggu Pembayaran
          </span>
        </div>
      </header>

      <div class="mb-6 flex items-start gap-3 rounded-2xl border-l-4 border-[#F59E0B] bg-[#FEF3C7] px-4 py-3 text-sm leading-6 text-[#7c5a12] shadow-sm">
        <div class="text-base leading-none">ℹ️</div>
        <p class="m-0">Saat ini pembayaran hanya QRIS. Metode lain sedang maintenance.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <section class="grid gap-6">
          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_45px_rgba(43,31,26,0.08)] ring-1 ring-slate-200/70 sm:p-6">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Timer</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">Waktu Pembayaran</h2>
              </div>
              <span class="rounded-full bg-[#2A9D8F]/10 px-3 py-1 text-xs font-bold text-[#2A9D8F]">Aman jika di bawah 15 menit</span>
            </div>
            <div class="flex justify-center">
              <PaymentCountdown client:load />
            </div>
            <p class="mt-4 text-center text-sm text-slate-600">Timer berdetak halus. Hijau saat aman, kuning saat mendekati batas, merah saat hampir habis.</p>
          </article>

          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_45px_rgba(43,31,26,0.08)] ring-1 ring-slate-200/70 sm:p-6">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Detail Pesanan</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">Menu yang Dipesan</h2>
              </div>
              <span class="rounded-full bg-[#2A9D8F]/10 px-3 py-1 text-xs font-bold text-[#2A9D8F]">Live from Supabase</span>
            </div>

            <div class="overflow-hidden rounded-2xl border border-slate-200">
              <div class="hidden grid-cols-[72px_1fr_auto] gap-4 bg-[#fff7f2] px-4 py-3 text-xs font-black uppercase tracking-[0.2em] text-slate-600 sm:grid">
                <span>Foto</span>
                <span>Menu</span>
                <span class="text-right">Harga</span>
              </div>
              <div id="menuList" class="divide-y divide-slate-200">
                <div class="px-4 py-6 text-center text-sm text-slate-500">Memuat detail pesanan...</div>
              </div>
            </div>

            <div class="mt-4 rounded-2xl bg-[#fff7f2] p-4 ring-1 ring-[#e76f51]/10">
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-bold text-slate-600">Total Harga</span>
                <strong id="totalValue" class="text-2xl font-black tracking-tight text-slate-900">-</strong>
              </div>
            </div>
          </article>
        </section>

        <aside class="grid gap-6">
          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_45px_rgba(43,31,26,0.08)] ring-1 ring-slate-200/70 sm:p-6">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">Metode Pembayaran</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">QRIS / GoPay</h2>
              </div>
              <span class="rounded-full bg-[#2A9D8F]/10 px-3 py-1 text-xs font-bold text-[#2A9D8F]">Rekomendasi</span>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <button type="button" class="rounded-2xl border border-[#e76f51]/20 bg-[#fff7f2] px-4 py-3 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="block text-sm font-black text-slate-900">QRIS</span>
                <span class="mt-1 block text-xs leading-5 text-slate-600">Scan QR code dengan aplikasi pembayaran apa pun.</span>
              </button>
              <button type="button" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="block text-sm font-black text-slate-900">GoPay</span>
                <span class="mt-1 block text-xs leading-5 text-slate-600">Pembayaran cepat melalui dompet digital.</span>
              </button>
            </div>
          </article>

          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_45px_rgba(43,31,26,0.08)] ring-1 ring-slate-200/70 sm:p-6">
            <div class="mb-4 text-center">
              <p class="text-xs font-black uppercase tracking-[0.24em] text-[#e76f51]">QR Code</p>
              <h2 class="mt-1 text-xl font-black text-slate-900">Scan untuk bayar</h2>
            </div>

            <div class="mx-auto flex w-full max-w-[250px] items-center justify-center rounded-[1.25rem] border-2 border-dashed border-[#e76f51] bg-white p-4 shadow-sm">
              <div id="qrStage" class="flex h-[250px] w-[250px] items-center justify-center rounded-2xl bg-white">
                <p class="text-sm text-slate-500">Memuat QR code...</p>
              </div>
            </div>

            <div class="mt-4 flex flex-col items-center gap-2 text-center">
              <div class="text-2xl">📷</div>
              <p class="text-sm leading-6 text-slate-600">
                Scan QR code dengan GoPay, OVO, atau DANA
              </p>
            </div>

            <ol class="mt-5 grid gap-3">
              <li class="flex gap-3 rounded-2xl bg-[#FDF8F5] p-3 ring-1 ring-slate-200">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-[#e76f51] text-sm font-black text-white">1</span>
                <div>
                  <strong class="block text-sm text-slate-900">Buka aplikasi pembayaran</strong>
                  <p class="m-0 text-xs leading-5 text-slate-600">Gunakan aplikasi dompet digital yang mendukung QRIS.</p>
                </div>
              </li>
              <li class="flex gap-3 rounded-2xl bg-[#FDF8F5] p-3 ring-1 ring-slate-200">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-[#e76f51] text-sm font-black text-white">2</span>
                <div>
                  <strong class="block text-sm text-slate-900">Scan QR code</strong>
                  <p class="m-0 text-xs leading-5 text-slate-600">Arahkan kamera ke QR code yang tampil di halaman ini.</p>
                </div>
              </li>
              <li class="flex gap-3 rounded-2xl bg-[#FDF8F5] p-3 ring-1 ring-slate-200">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-[#2A9D8F] text-sm font-black text-white">3</span>
                <div>
                  <strong class="block text-sm text-slate-900">Konfirmasi dan tunggu sukses</strong>
                  <p class="m-0 text-xs leading-5 text-slate-600">Setelah berhasil, status akan berubah otomatis.</p>
                </div>
              </li>
            </ol>

            <div class="mt-5 flex flex-col gap-3 sm:flex-row">
              <button id="refreshButton" type="button" class="inline-flex items-center justify-center rounded-2xl border border-[#e76f51] px-4 py-3 text-sm font-black text-[#e76f51] transition hover:bg-[#e76f51] hover:text-white">
                🔄 Cek Status Pembayaran
              </button>
              <a id="whatsappButton" href="#" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-2xl bg-[#25D366] px-4 py-3 text-sm font-black text-white shadow-[0_14px_28px_rgba(37,211,102,0.22)] transition hover:-translate-y-0.5">
                💬 Hubungi Kasir
              </a>
            </div>
          </article>

          <article class="rounded-[1.5rem] bg-white p-5 shadow-[0_18px_45px_rgba(43,31,26,0.08)] ring-1 ring-slate-200/70 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-black text-slate-900">Info Pesanan</h2>
              <span class="inline-flex animate-pulse items-center rounded-full bg-[#FEF3C7] px-3 py-1 text-xs font-bold text-[#92400e]">Menunggu Pembayaran</span>
            </div>
            <dl class="mt-4 grid gap-3 text-sm text-slate-600">
              <div class="flex items-center justify-between gap-4 rounded-2xl bg-[#FDF8F5] px-4 py-3 ring-1 ring-slate-200">
                <dt class="font-semibold">Order ID</dt>
                <dd id="infoOrderNumber" class="font-black text-slate-900">-</dd>
              </div>
              <div class="flex items-center justify-between gap-4 rounded-2xl bg-[#FDF8F5] px-4 py-3 ring-1 ring-slate-200">
                <dt class="font-semibold">Customer</dt>
                <dd id="infoCustomer" class="font-black text-slate-900">-</dd>
              </div>
            </dl>
          </article>
        </aside>
      </div>

      <div class="mt-6">
        <p id="noteText" class="m-0 text-sm text-slate-600">Pesanan Anda sedang menunggu pembayaran.</p>
        <div id="timeoutArea" class="mt-4"></div>
      </div>
    </section>

    <ConfettiEffect client:load />
  </main>

  <script is:inline type="module">
    const ORDER_ID = ${JSON.stringify(id)}
    const TESTING = ${JSON.stringify(testing)}
    const WHATSAPP_CS = ${JSON.stringify(whatsappCs)}
    const MIDTRANS_CLIENT_KEY = ${JSON.stringify(midtransClientKey)}
    const MIDTRANS_IS_PRODUCTION = ${JSON.stringify(midtransProduction)}

    const money = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    })

    const els = {
      statusBadge: document.getElementById('statusBadge'),
      qrStage: document.getElementById('qrStage'),
      refreshButton: document.getElementById('refreshButton'),
      whatsappButton: document.getElementById('whatsappButton'),
      menuList: document.getElementById('menuList'),
      totalValue: document.getElementById('totalValue'),
      infoOrderNumber: document.getElementById('infoOrderNumber'),
      infoCustomer: document.getElementById('infoCustomer'),
      noteText: document.getElementById('noteText'),
      timeoutArea: document.getElementById('timeoutArea'),
      infoStatus: document.getElementById('infoStatus'),
      infoTime: document.getElementById('infoTime'),
      infoType: document.getElementById('infoType'),
    }

    const state = {
      deadline: Date.now() + 15 * 60 * 1000,
      timerId: null,
      pollId: null,
      timedOut: false,
      retries404: 0,
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;')
    }

    function formatDateTime(value) {
      if (!value) return '-'
      return new Intl.DateTimeFormat('id-ID', {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }).format(new Date(value))
    }

    function normalizePhone(value) {
      return String(value || '').replace(/[^\d]/g, '')
    }

    function waLink(message) {
      const phone = normalizePhone(WHATSAPP_CS)
      if (!phone) return '#'
      return `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
    }

    function setWhatsappButton(orderId) {
      els.whatsappButton.href = waLink(`Halo Kasir, saya ingin konfirmasi pembayaran untuk pesanan #${orderId}.`)
    }

    function setStatus(status) {
      const value = String(status || 'pending').toLowerCase()
      const map = {
        pending: 'Menunggu Pembayaran',
        paid: 'Pembayaran Diterima',
        settlement: 'Pembayaran Diterima',
        capture: 'Pembayaran Diterima',
        failed: 'Pembayaran Gagal',
        cancel: 'Pesanan Dibatalkan',
        expired: 'Waktu Habis',
      }
      els.statusBadge.innerText = map[value] || 'Menunggu Pembayaran'
      els.infoStatus && (els.infoStatus.innerText = map[value] || 'Menunggu Pembayaran')
    }

    function setDeadline(createdAt) {
      const base = createdAt ? new Date(createdAt).getTime() : Date.now()
      state.deadline = base + 15 * 60 * 1000
    }

    function formatCountdown(ms) {
      const total = Math.max(0, Math.floor(ms / 1000))
      const minutes = String(Math.floor(total / 60)).padStart(2, '0')
      const seconds = String(total % 60).padStart(2, '0')
      return `${minutes}:${seconds}`
    }

    function tickCountdown() {
      const remaining = state.deadline - Date.now()
      const timerValue = formatCountdown(remaining)
      const tone = remaining < 2 * 60 ? '#ef4444' : remaining < 5 * 60 * 1000 ? '#f59e0b' : '#2A9D8F'
      els.statusBadge.classList.toggle('animate-pulse', remaining > 0)
      els.statusBadge.style.backgroundColor = remaining > 0 ? '#FEF3C7' : '#FEE2E2'
      els.statusBadge.style.color = remaining > 0 ? '#92400e' : '#991b1b'
      const countdownNodes = document.querySelectorAll('[data-countdown]')
      countdownNodes.forEach((node) => {
        node.textContent = timerValue
        node.style.color = tone
      })

      if (remaining <= 0 && !state.timedOut) {
        state.timedOut = true
        els.noteText.innerText = 'Waktu habis, silakan hubungi kasir.'
        els.timeoutArea.innerHTML = `
          <a class="inline-flex items-center justify-center rounded-2xl bg-[#ef4444] px-4 py-3 text-sm font-black text-white shadow-[0_14px_28px_rgba(239,68,68,0.18)]" href="${waLink(`Halo Kasir, waktu pembayaran pesanan #${ORDER_ID} sudah habis. Mohon bantu batalkan pesanan.`)}" target="_blank" rel="noreferrer">
            Batalkan Pesanan
          </a>
        `
        clearInterval(state.timerId)
        clearInterval(state.pollId)
      }
    }

    function renderMenuItems(items = []) {
      if (!items.length) {
        els.menuList.innerHTML = '<div class="px-4 py-6 text-center text-sm text-slate-500">Detail pesanan belum tersedia.</div>'
        return
      }

      els.menuList.innerHTML = items.map((item) => {
        const nama = item.menu?.nama || `Menu #${item.id_menu}`
        const jumlah = Number(item.jumlah || 0)
        const harga = Number(item.harga_saat_pesan || 0)
        const total = jumlah * harga
        const image = item.menu?.gambar_url
        return `
          <div class="grid grid-cols-[72px_1fr_auto] items-center gap-4 px-4 py-4">
            <div class="overflow-hidden rounded-2xl bg-[#FDF8F5] ring-1 ring-slate-200">
              ${image ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(nama)}" class="h-18 w-18 object-cover" />` : '<div class="flex h-18 w-18 items-center justify-center text-xs font-bold text-slate-500">Menu</div>'}
            </div>
            <div>
              <strong class="block text-sm font-black text-slate-900">${escapeHtml(nama)}</strong>
              <span class="mt-1 inline-flex rounded-full bg-[#2A9D8F]/10 px-2 py-1 text-xs font-semibold text-[#2A9D8F]">Qty ${jumlah}</span>
            </div>
            <div class="text-right text-sm font-black text-slate-900">${money.format(total)}</div>
          </div>
        `
      }).join('')
    }

    function renderQr(source, snapToken) {
      if (source) {
        els.qrStage.innerHTML = `
          <img
            src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(source)}"
            alt="QR code pembayaran"
            class="h-[250px] w-[250px] rounded-2xl object-contain"
            width="250"
            height="250"
          />
        `
        return
      }

      if (snapToken && window.snap?.embed) {
        els.qrStage.innerHTML = '<div id="snap-embed" class="w-full"></div>'
        window.snap.embed(snapToken, {
          embedId: 'snap-embed',
          onPending: () => {},
          onSuccess: () => {},
          onError: () => {},
        })
        return
      }

      els.qrStage.innerHTML = '<p class="text-sm text-slate-500">Memuat QR code...</p>'
    }

    function loadSnapScript() {
      if (window.snap) return Promise.resolve()
      return new Promise((resolve, reject) => {
        const script = document.createElement('script')
        script.async = true
        script.src = MIDTRANS_IS_PRODUCTION ? 'https://app.midtrans.com/snap/snap.js' : 'https://app.sandbox.midtrans.com/snap/snap.js'
        script.setAttribute('data-client-key', MIDTRANS_CLIENT_KEY)
        script.onload = resolve
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    function renderOrder(data) {
      const pesanan = data?.pesanan
      const pembayaran = data?.pembayaran || {}
      if (!pesanan) {
        els.qrStage.innerHTML = '<p class="text-sm text-slate-500">Pesanan tidak ditemukan.</p>'
        return
      }

      setDeadline(pesanan.created_at)
      els.infoOrderNumber.innerText = `#${pesanan.id}`
      els.infoCustomer.innerText = pesanan.customer_name || '-'
      els.infoTime && (els.infoTime.innerText = formatDateTime(pesanan.created_at))
      els.infoType && (els.infoType.innerText = pesanan.tipe_pesanan === 'dine_in' ? 'Dine-in' : pesanan.tipe_pesanan === 'delivery' ? 'Delivery' : 'Takeaway')
      els.totalValue.innerText = money.format(Number(pesanan.total || 0))
      renderMenuItems(pesanan.detail_pesanan || [])
      setStatus(pembayaran.status || pesanan.status || 'pending')
      setWhatsappButton(pesanan.id)
      renderQr(pembayaran.qr_code || pembayaran.qr_url || pembayaran.redirect_url || data?.midtrans?.qr_url || data?.midtrans?.redirect_url, pembayaran.snap_token)

      if (['paid', 'settlement', 'capture'].includes(String(pembayaran.status || '').toLowerCase())) {
        window.location.href = `/pembayaran/sukses/${pesanan.id}`
      }
    }

    async function refreshStatus() {
      try {
        const url = new URL('/api/cek-status', window.location.origin)
        url.searchParams.set('id', ORDER_ID)
        if (TESTING) url.searchParams.set('testing', '1')
        const response = await fetch(url, { cache: 'no-store' })
        const data = await response.json()

        if (response.status === 404 || data?.not_found) {
          state.retries404 += 1
          if (data?.pesanan) {
            renderOrder({
              ...data,
              pembayaran: data.pembayaran || { status: 'pending', metode: 'midtrans' },
            })
          }
          if (state.retries404 >= 10) {
            els.noteText.innerText = 'Transaksi belum ditemukan di Midtrans. Status dianggap pending.'
          }
          return
        }

        renderOrder(data)
      } catch (error) {
        console.error(error)
        els.noteText.innerText = 'Gagal memuat status pembayaran. Coba lagi sebentar.'
      }
    }

    els.refreshButton.addEventListener('click', () => refreshStatus())

    state.timerId = window.setInterval(tickCountdown, 1000)
    state.pollId = window.setInterval(refreshStatus, 5000)
    tickCountdown()

    loadSnapScript().catch(() => {})
    refreshStatus()
  </script>
</Layout>
