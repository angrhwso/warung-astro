---
import Layout from '../../layouts/Layout.astro'
import ConfettiEffect from '../../components/ConfettiEffect.jsx'

const id = Astro.params.id
const whatsappCs = import.meta.env.PUBLIC_WHATSAPP_CS || ''
const testing = Astro.url.searchParams.get('testing') === '1'
---

<Layout title={`Pembayaran Pesanan #${id}`}>
  <main class="payment-page-shell">
    <section
      class="payment-page"
      data-order-id={id}
      data-testing={testing ? 'true' : 'false'}
      data-whatsapp-cs={whatsappCs}
    >
      <header class="payment-hero">
        <div>
          <p class="payment-eyebrow">Pembayaran</p>
          <h1>🍜 Selesaikan Pembayaran</h1>
          <p class="payment-subtitle">Silakan selesaikan pesanan Anda sebelum timer habis.</p>
        </div>
        <div class="payment-badges">
          <span class="payment-badge payment-badge-muted">No. Pesanan: <strong id="orderNumber">#{id}</strong></span>
          <span class="payment-badge payment-badge-warning" id="statusBadge">Menunggu pembayaran</span>
        </div>
      </header>

      <div class="payment-announcement" role="note" aria-label="Informasi pembayaran">
        <span class="payment-announcement-icon">ℹ️</span>
        <p>
          Saat ini kami menyarankan pembayaran lewat QRIS untuk proses yang lebih cepat. Metode lain tetap tersedia melalui Midtrans,
          tetapi tampilan utama difokuskan ke QR code agar lebih mudah dipindai.
        </p>
      </div>

      <section class="payment-grid">
        <div class="payment-column">
          <article class="payment-card payment-card-timer">
            <p class="payment-card-label">Batas Waktu Pembayaran</p>
            <div class="payment-countdown" id="countdown">15:00</div>
            <p class="payment-helper" id="timerHelper">Waktu tersisa untuk menyelesaikan pembayaran.</p>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Informasi Pesanan</h2>
              <span class="payment-mini-badge" id="paymentMethodTag">QRIS / Midtrans</span>
            </div>
            <div class="payment-info-grid" id="orderInfoGrid">
              <div class="payment-info-item">
                <span>Nomor Pesanan</span>
                <strong id="infoOrderNumber">-</strong>
              </div>
              <div class="payment-info-item">
                <span>Total Bayar</span>
                <strong id="infoTotal">-</strong>
              </div>
              <div class="payment-info-item">
                <span>Status</span>
                <strong id="infoStatus">Menunggu pembayaran</strong>
              </div>
              <div class="payment-info-item">
                <span>Waktu Pesanan</span>
                <strong id="infoTime">-</strong>
              </div>
            </div>
            <div class="payment-order-meta" id="orderMeta">
              <p><strong>Tipe Pesanan:</strong> <span id="infoType">-</span></p>
              <p><strong>Nama Customer:</strong> <span id="infoCustomer">-</span></p>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Detail Menu</h2>
              <span class="payment-mini-note">Ringkasan pesanan</span>
            </div>
            <div class="payment-table-wrap">
              <table class="payment-table">
                <thead>
                  <tr>
                    <th>Menu</th>
                    <th>Jumlah</th>
                    <th>Harga</th>
                  </tr>
                </thead>
                <tbody id="menuTable">
                  <tr>
                    <td colspan="3" class="payment-empty-cell">Memuat detail menu...</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="payment-totals">
              <div>
                <span>Subtotal</span>
                <strong id="subtotalValue">-</strong>
              </div>
              <div>
                <span>Total</span>
                <strong id="totalValue">-</strong>
              </div>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Metode Pembayaran</h2>
              <span class="payment-mini-note">Highlight metode aktif</span>
            </div>
            <div class="payment-method-grid" id="methodGrid"></div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Instruksi Pembayaran</h2>
              <span class="payment-mini-note">Ikuti langkah berikut</span>
            </div>
            <ol class="payment-steps" id="paymentSteps"></ol>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Tombol Aksi</h2>
              <span class="payment-mini-note">Cepat dan praktis</span>
            </div>
            <div class="payment-actions">
              <a class="payment-button payment-button-primary" id="whatsappButton" href="#" target="_blank" rel="noreferrer">💬 Hubungi Kasir</a>
              <button class="payment-button payment-button-secondary" id="refreshButton" type="button">🔄 Cek Status Pembayaran</button>
            </div>
          </article>
        </div>

        <aside class="payment-column payment-side">
          <article class="payment-card payment-qr-card">
            <div class="payment-card-header payment-card-header-center">
              <h2>QR Code Pembayaran</h2>
            </div>
            <div class="payment-qr-timer" id="sideTimer">15:00</div>
            <div class="payment-qr-shell">
              <div class="payment-qr-stage" id="qrStage">
                <p class="payment-empty-state">Memuat QR code...</p>
              </div>
            </div>
            <p class="payment-qr-caption">
              Scan QR code di atas menggunakan GoPay, OVO, Dana, atau aplikasi QRIS lainnya.
            </p>
            <div class="payment-qr-actions" id="qrActions"></div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Announcement</h2>
            </div>
            <div class="payment-announcement payment-announcement-block">
              <span class="payment-announcement-icon">ℹ️</span>
              <p>
                Metode pembayaran lain tetap aktif di Midtrans, tetapi jika QR belum muncul, tunggu beberapa detik lalu klik
                <strong>Cek Status Pembayaran</strong>.
              </p>
            </div>
          </article>

          <article class="payment-card">
            <div class="payment-card-header">
              <h2>Catatan</h2>
            </div>
            <p class="payment-helper" id="noteText">Pesanan Anda sedang menunggu pembayaran.</p>
            <div id="timeoutArea"></div>
          </article>
        </aside>
      </section>
    </section>

    <ConfettiEffect client:load />
  </main>

  <script is:inline type="module">
    const ORDER_ID = ${JSON.stringify(id)}
    const TESTING = ${JSON.stringify(testing)}
    const WHATSAPP_CS = ${JSON.stringify(whatsappCs)}

    const money = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    })

    const countdownEl = document.getElementById('countdown')
    const sideTimerEl = document.getElementById('sideTimer')
    const timerHelperEl = document.getElementById('timerHelper')
    const statusBadgeEl = document.getElementById('statusBadge')
    const paymentMethodTagEl = document.getElementById('paymentMethodTag')
    const infoOrderNumberEl = document.getElementById('infoOrderNumber')
    const infoTotalEl = document.getElementById('infoTotal')
    const infoStatusEl = document.getElementById('infoStatus')
    const infoTimeEl = document.getElementById('infoTime')
    const infoTypeEl = document.getElementById('infoType')
    const infoCustomerEl = document.getElementById('infoCustomer')
    const menuTableEl = document.getElementById('menuTable')
    const subtotalValueEl = document.getElementById('subtotalValue')
    const totalValueEl = document.getElementById('totalValue')
    const methodGridEl = document.getElementById('methodGrid')
    const paymentStepsEl = document.getElementById('paymentSteps')
    const qrStageEl = document.getElementById('qrStage')
    const qrActionsEl = document.getElementById('qrActions')
    const noteTextEl = document.getElementById('noteText')
    const timeoutAreaEl = document.getElementById('timeoutArea')
    const whatsappButtonEl = document.getElementById('whatsappButton')
    const refreshButtonEl = document.getElementById('refreshButton')

    const paymentMethods = [
      {
        key: 'qris',
        icon: '📱',
        title: 'QRIS',
        desc: 'Scan QR Code dengan GoPay, OVO, Dana, dll',
        steps: [
          'Tunggu QR code tampil sempurna di halaman ini.',
          'Buka aplikasi pembayaran Anda dan pilih menu QRIS.',
          'Scan QR code, lalu konfirmasi nominal pembayaran.',
        ],
      },
      {
        key: 'gopay',
        icon: '💳',
        title: 'GoPay',
        desc: 'Bayar dengan GoPay',
        steps: [
          'Buka aplikasi GoPay pada ponsel Anda.',
          'Ikuti instruksi pembayaran yang muncul dari Midtrans.',
          'Selesaikan pembayaran sebelum waktu habis.',
        ],
      },
      {
        key: 'shopeepay',
        icon: '🛍️',
        title: 'ShopeePay',
        desc: 'Bayar dengan ShopeePay',
        steps: [
          'Buka aplikasi Shopee dan masuk ke ShopeePay.',
          'Pilih bayar pada notifikasi atau kode pembayaran.',
          'Pastikan saldo cukup lalu konfirmasi transaksi.',
        ],
      },
      {
        key: 'bank_transfer',
        icon: '🏦',
        title: 'Bank Transfer',
        desc: 'Transfer Bank BCA / BNI / BRI / Mandiri',
        steps: [
          'Gunakan instruksi transfer bank yang tersedia di Midtrans.',
          'Salin nomor virtual account atau rekening tujuan.',
          'Lakukan transfer sesuai nominal pesanan.',
        ],
      },
    ]

    const state = {
      deadline: Date.now() + 15 * 60 * 1000,
      timerId: null,
      pollId: null,
      timedOut: false,
      qrLoaded: false,
      lastStatus: null,
      loadCount: 0,
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;')
    }

    function formatDateTime(value) {
      if (!value) return '-'
      const date = new Date(value)
      return new Intl.DateTimeFormat('id-ID', {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }).format(date)
    }

    function formatCountdown(ms) {
      const safe = Math.max(0, ms)
      const totalSeconds = Math.floor(safe / 1000)
      const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, '0')
      const seconds = String(totalSeconds % 60).padStart(2, '0')
      return `${minutes}:${seconds}`
    }

    function normalizePhone(phone) {
      return String(phone || '').replace(/[^\d]/g, '')
    }

    function whatsappLink(message) {
      const phone = normalizePhone(WHATSAPP_CS)
      if (!phone) return '#'
      return `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
    }

    function setWhatsappButton(orderId) {
      const message = `Halo Kasir, saya ingin konfirmasi pembayaran untuk pesanan #${orderId}.`
      whatsappButtonEl.href = whatsappLink(message)
    }

    function renderMethodGrid(activeMethod = 'qris') {
      const cards = paymentMethods.map((method) => {
        const active = method.key === activeMethod
        return `
          <article class="method-card ${active ? 'is-active' : ''}">
            <div class="method-icon">${method.icon}</div>
            <div>
              <strong>${escapeHtml(method.title)}</strong>
              <p>${escapeHtml(method.desc)}</p>
            </div>
          </article>
        `
      }).join('')

      methodGridEl.innerHTML = cards
    }

    function setPaymentSteps(method = 'qris') {
      const selected = paymentMethods.find((item) => item.key === method) || paymentMethods[0]
      paymentStepsEl.innerHTML = selected.steps.map((step) => `<li>${escapeHtml(step)}</li>`).join('')
      paymentMethodTagEl.innerText = `${selected.icon} ${selected.title}`
    }

    function setStatusBadge(status) {
      const normalized = (status || 'pending').toLowerCase()
      const map = {
        pending: { label: 'Menunggu pembayaran', className: 'status-pending' },
        paid: { label: 'Pembayaran diterima', className: 'status-success' },
        settlement: { label: 'Pembayaran diterima', className: 'status-success' },
        capture: { label: 'Pembayaran diterima', className: 'status-success' },
        failed: { label: 'Pembayaran gagal', className: 'status-danger' },
        cancel: { label: 'Pesanan dibatalkan', className: 'status-danger' },
        expired: { label: 'Waktu pembayaran habis', className: 'status-danger' },
      }
      const state = map[normalized] || map.pending
      statusBadgeEl.className = `payment-badge ${state.className}`
      statusBadgeEl.innerText = state.label
      infoStatusEl.innerText = state.label
      state.lastStatus = normalized
    }

    function renderMenuItems(items = []) {
      if (!items.length) {
        menuTableEl.innerHTML = '<tr><td colspan="3" class="payment-empty-cell">Detail menu belum tersedia.</td></tr>'
        return
      }

      menuTableEl.innerHTML = items.map((item) => {
        const nama = item.menu?.nama || item.nama_menu || `Menu #${item.id_menu}`
        const qty = Number(item.jumlah || 0)
        const hargaSatuan = Number(item.harga_saat_pesan ?? item.harga ?? 0)
        const totalItem = hargaSatuan * qty
        return `
          <tr>
            <td>${escapeHtml(nama)}</td>
            <td>${qty}</td>
            <td>${money.format(totalItem)}</td>
          </tr>
        `
      }).join('')
    }

    function buildQrSource(data) {
      const payment = data?.pembayaran || {}
      const midtrans = data?.midtrans || {}
      const candidates = [
        payment.snap_token && `snap-token:${payment.snap_token}`,
        payment.qr_url,
        payment.redirect_url,
        midtrans.qr_url,
        midtrans.redirect_url,
      ].filter(Boolean)

      return candidates[0] || null
    }

    function loadSnapScript() {
      return new Promise((resolve, reject) => {
        if (window.snap) return resolve(window.snap)

        const existing = document.querySelector('script[data-midtrans-snap="true"]')
        if (existing) {
          existing.addEventListener('load', () => resolve(window.snap), { once: true })
          existing.addEventListener('error', reject, { once: true })
          return
        }

        const script = document.createElement('script')
        script.dataset.midtransSnap = 'true'
        script.async = true
        script.src = import.meta.env.PUBLIC_MIDTRANS_IS_PRODUCTION === 'true'
          ? 'https://app.midtrans.com/snap/snap.js'
          : 'https://app.sandbox.midtrans.com/snap/snap.js'
        script.setAttribute('data-client-key', import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY || '')
        script.onload = () => resolve(window.snap)
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    function renderQrFallback(source) {
      if (!source) {
        qrStageEl.innerHTML = '<p class="payment-empty-state">Menunggu QR code dari Midtrans...</p>'
        return
      }

      if (source.startsWith('snap-token:')) {
        const token = source.replace('snap-token:', '')
        qrStageEl.innerHTML = '<p class="payment-empty-state">Memuat tampilan pembayaran...</p>'
        loadSnapScript()
          .then(() => {
            if (!window.snap?.embed) {
              qrStageEl.innerHTML = '<p class="payment-empty-state">Midtrans Snap tidak tersedia.</p>'
              return
            }
            qrStageEl.innerHTML = '<div id="snap-embed"></div>'
            window.snap.embed(token, {
              embedId: 'snap-embed',
              onSuccess: () => {
                noteTextEl.innerText = 'Pembayaran berhasil diproses.'
              },
              onPending: () => {
                noteTextEl.innerText = 'Menunggu konfirmasi pembayaran.'
              },
              onError: () => {
                noteTextEl.innerText = 'Gagal memuat tampilan pembayaran Midtrans.'
              },
              onClose: () => {
                noteTextEl.innerText = 'Tampilan pembayaran ditutup.'
              },
            })
          })
          .catch(() => {
            qrStageEl.innerHTML = '<p class="payment-empty-state">Gagal memuat Snap Midtrans.</p>'
          })
        return
      }

      const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(source)}`
      qrStageEl.innerHTML = `
        <img
          class="payment-qr-image"
          src="${qrUrl}"
          alt="QR code pembayaran"
          width="300"
          height="300"
        />
      `
    }

    function renderTimeoutAction(orderId) {
      const message = `Halo Kasir, waktu pembayaran pesanan #${orderId} sudah habis. Mohon bantu batalkan atau bantu lanjutkan prosesnya.`
      timeoutAreaEl.innerHTML = `
        <a class="payment-button payment-button-danger" href="${whatsappLink(message)}" target="_blank" rel="noreferrer">
          Batalkan Pesanan
        </a>
      `
    }

    function clearTimeoutAction() {
      timeoutAreaEl.innerHTML = ''
    }

    function stopTimers() {
      if (state.timerId) window.clearInterval(state.timerId)
      if (state.pollId) window.clearInterval(state.pollId)
    }

    function setDeadlineFromOrder(createdAt) {
      const base = createdAt ? new Date(createdAt).getTime() : Date.now()
      state.deadline = base + 15 * 60 * 1000
    }

    function tickCountdown() {
      const remaining = state.deadline - Date.now()
      const formatted = formatCountdown(remaining)
      countdownEl.innerText = formatted
      sideTimerEl.innerText = formatted

      if (remaining <= 0 && !state.timedOut) {
        state.timedOut = true
        timerHelperEl.innerText = 'Waktu pembayaran habis.'
        noteTextEl.innerText = 'Waktu habis, silakan hubungi kasir.'
        renderTimeoutAction(ORDER_ID)
        stopTimers()
      }
    }

    function renderOrder(data) {
      const pesanan = data?.pesanan
      const pembayaran = data?.pembayaran || {}

      if (!pesanan) {
        qrStageEl.innerHTML = '<p class="payment-empty-state">Pesanan tidak ditemukan.</p>'
        noteTextEl.innerText = 'Data pesanan belum tersedia.'
        setStatusBadge('pending')
        return
      }

      setDeadlineFromOrder(pesanan.created_at)
      infoOrderNumberEl.innerText = `#${pesanan.id}`
      infoTotalEl.innerText = money.format(Number(pesanan.total || 0))
      infoTimeEl.innerText = formatDateTime(pesanan.created_at)
      infoCustomerEl.innerText = pesanan.customer_name || '-'
      infoTypeEl.innerText = pesanan.tipe_pesanan === 'dine_in'
        ? `Dine-in${pesanan.meja?.nomor_meja ? ` (Meja ${pesanan.meja.nomor_meja})` : ''}`
        : pesanan.tipe_pesanan === 'delivery'
          ? 'Delivery'
          : 'Takeaway'

      subtotalValueEl.innerText = money.format(Number(pesanan.subtotal || 0))
      totalValueEl.innerText = money.format(Number(pesanan.total || 0))
      renderMenuItems(pesanan.detail_pesanan || [])

      const statusValue = pembayaran.status || pesanan.status || 'pending'
      setStatusBadge(statusValue)

      const activeMethod = pembayaran.metode === 'midtrans' ? 'qris' : (pembayaran.metode || 'qris')
      renderMethodGrid(activeMethod)
      setPaymentSteps(activeMethod)
      setWhatsappButton(pesanan.id)

      const qrSource = buildQrSource(data)
      renderQrFallback(qrSource)

      if (statusValue === 'paid' || statusValue === 'settlement' || statusValue === 'capture') {
        stopTimers()
        clearTimeoutAction()
        timerHelperEl.innerText = 'Pembayaran sudah berhasil diterima.'
        noteTextEl.innerText = 'Terima kasih, pesanan Anda sedang kami proses.'
        return
      }

      if (state.timedOut) {
        renderTimeoutAction(pesanan.id)
      } else {
        clearTimeoutAction()
      }
    }

    async function refreshStatus(manual = false) {
      if (state.timedOut && !manual) return

      try {
        const url = new URL('/api/cek-status', window.location.origin)
        url.searchParams.set('id', ORDER_ID)
        if (TESTING) url.searchParams.set('testing', '1')

        const response = await fetch(url.toString(), { cache: 'no-store' })
        const data = await response.json()
        state.loadCount += 1
        state.lastStatus = data?.status || data?.pembayaran?.status || null

        if (response.status === 404 || data?.not_found) {
          if (data?.pesanan) {
            renderOrder({
              ...data,
              pembayaran: data.pembayaran || {
                status: 'pending',
                metode: 'midtrans',
              },
            })
          }
          if (manual) {
            noteTextEl.innerText = 'Status transaksi belum ditemukan. Sistem akan mencoba lagi.'
          }
          if (state.loadCount >= 10 && !state.lastStatus) {
            noteTextEl.innerText = 'Transaksi masih belum ditemukan di Midtrans. Status dianggap pending.'
          }
          return
        }

        renderOrder(data)
      } catch (error) {
        noteTextEl.innerText = 'Gagal memuat status pembayaran. Silakan coba lagi.'
        console.error(error)
      }
    }

    refreshButtonEl.addEventListener('click', () => refreshStatus(true))

    if (TESTING) {
      noteTextEl.innerText = 'Mode testing aktif. Status pembayaran akan langsung disimulasikan.'
    }

    state.timerId = window.setInterval(tickCountdown, 1000)
    tickCountdown()

    state.pollId = window.setInterval(() => {
      refreshStatus(false)
    }, 5000)

    refreshStatus(true)
  </script>

  <style>
    :global(body) {
      background: #fdf8f5;
    }

    .payment-page-shell {
      min-height: 100vh;
      padding: 2rem 1rem 3rem;
      background:
        radial-gradient(circle at top left, rgba(231, 111, 81, 0.14), transparent 28%),
        radial-gradient(circle at top right, rgba(42, 157, 143, 0.12), transparent 24%),
        #fdf8f5;
    }

    .payment-page {
      max-width: 1180px;
      margin: 0 auto;
    }

    .payment-hero {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .payment-eyebrow {
      margin: 0 0 .35rem;
      color: #e76f51;
      font-size: .85rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .payment-hero h1 {
      margin: 0;
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1.05;
      color: #2b1f1a;
    }

    .payment-subtitle {
      margin: .6rem 0 0;
      color: rgba(43, 31, 26, .72);
      max-width: 56ch;
    }

    .payment-badges {
      display: flex;
      flex-wrap: wrap;
      gap: .7rem;
      align-items: center;
    }

    .payment-badge {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .75rem 1rem;
      border-radius: 999px;
      font-size: .92rem;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(43, 31, 26, .08);
    }

    .payment-badge strong {
      font-weight: 900;
    }

    .payment-badge-muted {
      color: #2b1f1a;
      background: rgba(255, 255, 255, .95);
    }

    .payment-badge-warning {
      background: #fef3c7;
      color: #92400e;
    }

    .status-pending {
      background: #fef3c7;
      color: #92400e;
    }

    .status-success {
      background: #dcfce7;
      color: #166534;
    }

    .status-danger {
      background: #fee2e2;
      color: #991b1b;
    }

    .payment-announcement {
      display: flex;
      align-items: flex-start;
      gap: .85rem;
      padding: .95rem 1rem;
      margin-bottom: 1rem;
      background: #fef3c7;
      border-left: 4px solid #f59e0b;
      border-radius: .95rem;
      color: #5c4211;
      box-shadow: 0 10px 24px rgba(43, 31, 26, .06);
    }

    .payment-announcement p {
      margin: 0;
      font-size: .94rem;
      line-height: 1.55;
    }

