---
import '../styles/globals.css'
import Toast from '../components/ui/Toast.jsx'

const title = Astro.props.title || 'Admin Warung Astro'
const active = Astro.props.active || '/admin/dashboard'
const links = [
  ['/admin/dashboard', 'Dashboard', 'M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-11h6V4h-6v5Z'],
  ['/admin/orders', 'Pesanan', 'M6 2h12v20l-3-2-3 2-3-2-3 2V2Zm3 6h6M9 12h6M9 16h4'],
  ['/admin/menu', 'Menu', 'M4 4h16M5 8h14l-1 12H6L5 8Zm4 4h6'],
  ['/admin/meja', 'Meja', 'M5 10h14v7H5v-7Zm2-6h10v6H7V4Zm-1 17v-4m12 4v-4'],
  ['/admin/reports', 'Laporan', 'M4 19V5m0 14h18M8 15v-4m5 4V7m5 8v-6'],
]
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a class="brand-mark mb-8" href="/admin/dashboard">
          <span class="brand-icon" aria-hidden="true">W</span>
          <span>Warung Roso Nyoto</span>
        </a>
        <nav class="grid gap-2">
          {links.map(([href, label, path]) => (
            <a class={`nav-link flex items-center gap-3 ${active === href ? 'bg-orange-100 text-warung-primary' : ''}`} href={href}>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={path} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {label}
            </a>
          ))}
        </nav>
      </aside>

      <div>
        <div class="admin-sidebar-mobile">
          <div class="flex items-center justify-between gap-3">
            <a class="brand-mark" href="/admin/dashboard">
              <span class="brand-icon" aria-hidden="true">W</span>
              <span>Admin</span>
            </a>
            <button class="mobile-menu-button" id="adminMobileButton" type="button" aria-label="Buka menu admin">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
          </div>
          <nav class="mobile-menu mt-3" id="adminMobileMenu">
            {links.map(([href, label]) => (
              <a class={`nav-link ${active === href ? 'bg-orange-100 text-warung-primary' : ''}`} href={href}>{label}</a>
            ))}
          </nav>
        </div>

        <slot />
      </div>
    </div>

    <Toast client:load />

    <script>
      const menu = document.getElementById('adminMobileMenu')
      const button = document.getElementById('adminMobileButton')
      button?.addEventListener('click', () => menu?.classList.toggle('open'))
    </script>
  </body>
</html>
