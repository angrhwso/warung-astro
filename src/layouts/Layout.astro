---
import '../styles/globals.css'
import Toast from '../components/ui/Toast.jsx'

const title = Astro.props.title || 'Warung Roso Nyoto'
const description = Astro.props.description || 'Sajian hangat, pembayaran QRIS, dan dashboard warung modern.'
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-navbar">
      <div class="site-navbar-inner">
        <a class="brand-mark" href="/">
          <span class="brand-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M4 11h16v2a7 7 0 0 1-7 7h-2a7 7 0 0 1-7-7v-2Z" stroke="currentColor" stroke-width="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2" />
            </svg>
          </span>
          <span>Warung Roso Nyoto</span>
        </a>

        <div class="nav-links">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/#menu">Menu</a>
          <a class="nav-link" href="/meja">Meja</a>
          <a class="cart-pill" href="/#keranjang">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m7.5 4.3 1.6-2.1M16.5 4.3l-1.6-2.1M3 6h18l-1.7 12.1A2 2 0 0 1 17.3 20H6.7a2 2 0 0 1-2-1.9L3 6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            Keranjang
            <span class="cart-badge" id="cartBadge">0</span>
          </a>
          <button class="secondary-button" id="darkToggle" type="button" aria-label="Toggle dark mode">☾</button>
        </div>

        <button class="mobile-menu-button" id="mobileMenuButton" type="button" aria-label="Buka menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="mobile-menu" id="mobileMenu">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/#menu">Menu</a>
        <a class="nav-link" href="/meja">Meja</a>
        <a class="nav-link" href="/#keranjang">Keranjang <span class="cart-badge" id="mobileCartBadge">0</span></a>
        <button class="secondary-button" id="mobileDarkToggle" type="button">Dark Mode</button>
      </div>
    </nav>

    <slot />

    <footer class="mx-auto max-w-7xl px-4 py-10 text-sm font-semibold sm:px-6 lg:px-8" style="color: var(--muted);">
      <div class="flex flex-col gap-3 border-t pt-6 sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--line);">
        <p>Warung Roso Nyoto. Sajian hangat untuk hari yang hangat.</p>
        <p class="font-display text-lg">Selamat makan.</p>
      </div>
    </footer>

    <Toast client:load />

    <script>
      const root = document.documentElement
      const mobileMenu = document.getElementById('mobileMenu')
      const mobileMenuButton = document.getElementById('mobileMenuButton')
      const darkToggle = document.getElementById('darkToggle')
      const mobileDarkToggle = document.getElementById('mobileDarkToggle')
      const cartBadge = document.getElementById('cartBadge')
      const mobileCartBadge = document.getElementById('mobileCartBadge')

      function applyTheme() {
        const saved = localStorage.getItem('warung-theme')
        const dark = saved === 'dark'
        root.classList.toggle('dark', dark)
      }

      function toggleTheme() {
        const next = root.classList.contains('dark') ? 'light' : 'dark'
        localStorage.setItem('warung-theme', next)
        applyTheme()
      }

      function updateCartBadge() {
        const keys = Object.keys(localStorage).filter((key) => key.startsWith('cart_'))
        const total = keys.reduce((sum, key) => {
          try {
            const cart = JSON.parse(localStorage.getItem(key) || '{}')
            return sum + (cart.items || []).reduce((n, item) => n + Number(item.jumlah || 0), 0)
          } catch {
            return sum
          }
        }, 0)
        if (cartBadge) cartBadge.textContent = String(total)
        if (mobileCartBadge) mobileCartBadge.textContent = String(total)
      }

      applyTheme()
      updateCartBadge()
      mobileMenuButton?.addEventListener('click', () => mobileMenu?.classList.toggle('open'))
      darkToggle?.addEventListener('click', toggleTheme)
      mobileDarkToggle?.addEventListener('click', toggleTheme)
      window.addEventListener('storage', updateCartBadge)
      window.addEventListener('warung-cart-updated', updateCartBadge)
    </script>
  </body>
</html>
